{
  "name": "Agentic SDLC Workshop",
  "build": {
    "dockerfile": ".devcontainer/Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-dotnettools.csdevkit"
      ],
      "settings": {
        "dotnet.defaultSolution": "MusicCatalog.slnx"
      }
    }
  },
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "NPM_CONFIG_UPDATE_NOTIFIER": "false"
  },
  "forwardPorts": [
    5080,
    5173
  ],
  "portsAttributes": {
    "5080": {
      "label": "Music Catalog API"
    },
    "5173": {
      "label": "Music Catalog front end",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": {
    "copilot-cli": "npm_config_ignore_scripts=false npm install --global @github/copilot",
    "apm-cli": "curl -sSL https://aka.ms/apm-unix | sh",
    "gh-aw": "gh extension install github/gh-aw --force",
    "dotnet-restore": "dotnet restore",
    "front-end-dependencies": "npm --prefix src/front ci"
  },
  "remoteUser": "vscode"
}
